# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/abc_workforce

# Generate a long random value before any real deployment
SESSION_SECRET=replace-with-a-long-random-secret

# Stripe will be connected later
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email/SMS providers will be connected later
EMAIL_FROM=workforce@example.org
